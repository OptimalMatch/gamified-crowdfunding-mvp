# Copy to .env. The release to pin: bin/fetch-engine.sh downloads
# unidatum-<version>-linux-amd64.tar.gz from the OptimalMatch/peer-to-peer-db releases.
UNIDATUM_VERSION=v2.372.0
# The SQL wire for the dashboards (Metabase logs in with these).
SQLD_USER=demo
SQLD_PASSWORD=demo-only-change-me
# The object store for closed rounds and proofs (MinIO).
MINIO_ROOT_USER=demo
MINIO_ROOT_PASSWORD=demo-only-change-me
# The round agent over MCP: its model and key stay out of the compose file.
# Leave the key empty and the agent drafts the round by rule instead.
ANTHROPIC_API_KEY=
ROUND_AGENT_MODEL=claude-sonnet-5
